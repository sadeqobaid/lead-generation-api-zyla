APP_NAME="Lead Generation API"
APP_ENV=development
DATABASE_URL=sqlite:///./lead_generation.db
# Production PostgreSQL pool controls. SQLite ignores these pool-size settings.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SECONDS=3600
DB_POOL_TIMEOUT_SECONDS=30
# Required by the local Docker Compose PostgreSQL service; use a secret manager in production.
POSTGRES_PASSWORD=lead_api_dev_password
# Use PostgreSQL in staging/production, for example:
# DATABASE_URL=postgresql+psycopg://lead_api:change-me@postgres:5432/lead_api
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
API_KEY_PEPPER=replace-with-a-long-random-pepper
DEFAULT_CREDITS=100
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
IDEMPOTENCY_BACKEND=memory
IDEMPOTENCY_TTL_SECONDS=86400
QUEUE_BACKEND=redis
QUEUE_STREAM=lead-generation-jobs
QUEUE_GROUP=lead-generation-workers
QUEUE_CONSUMER=worker-1
QUEUE_BLOCK_MS=5000
# Synthetic is for local tests/demos only. Use http with a licensed provider before launch.
PROVIDER_MODE=synthetic
PROVIDER_NAME=approved_http_provider
# For the included adapter, set PROVIDER_MODE=http and configure an approved licensed provider contract.
PROVIDER_URL=
PROVIDER_TOKEN=
PROVIDER_AUTH_SCHEME=bearer
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_DATA_SOURCE=Deployment-specific licensed B2B data provider; configure before marketplace launch.
PROVIDER_USE_POLICY=PROVIDER_CONTRACT_REQUIRED
# Pricing is intentionally deployment-defined until the marketplace offer is approved.
PRICING_MODEL=One credit per returned lead; marketplace price is deployment-defined.
FREE_TRIAL_CREDITS=0
# Required for a verified billing webhook in production; use a secret manager.
BILLING_WEBHOOK_SECRET=replace-with-a-long-random-billing-secret
ALLOW_SYNTHETIC_IN_PRODUCTION=false
METRICS_ENABLED=true
# Required in production when metrics are enabled.
METRICS_TOKEN=replace-with-a-long-random-metrics-token
LOG_LEVEL=INFO
DATA_RETENTION_DAYS=365
# Development convenience only. Production must set false and run Alembic explicitly.
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0

# Zyla marketplace edition. Keep disabled until a hosted endpoint and provider contract are ready.
ZYLA_ENABLED=false
# shared_token is the safe default. public is for controlled synthetic testing only.
ZYLA_AUTH_MODE=shared_token
ZYLA_SHARED_TOKEN=replace-with-a-long-random-zyla-token
ZYLA_TENANT_ID=00000000-0000-0000-0000-000000000001
ZYLA_TENANT_NAME=Zyla Marketplace Consumers
ZYLA_TENANT_SLUG=zyla-marketplace
ZYLA_DEFAULT_CREDITS=1000000
ZYLA_MAX_LIMIT=25
# Keep false for a paid listing unless Zyla is explicitly being used as a synthetic demo.
ZYLA_ALLOW_SYNTHETIC=false
